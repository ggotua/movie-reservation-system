# ---------------------------------------------------------------------------
# Movie Reservation System — frontend environment template.
#
# Copy this file to frontend/.env and adjust the values if needed.
# frontend/.env is git-ignored; never commit real values.
#
# Every VITE_* variable is compiled into the public browser bundle, so a
# VITE_* value must never be a secret. All three are read only by
# src/lib/config.ts.
# ---------------------------------------------------------------------------

# Base URL of the backend API. Optional; defaults to http://127.0.0.1:8000
# (the backend's CORS_ORIGINS allows the Vite dev server to call it).
VITE_API_BASE_URL=http://127.0.0.1:8000

# ISO 4217 currency code used to format money. Optional; defaults to GEL.
VITE_CURRENCY=GEL

# IANA time zone every showtime is displayed in. Optional; defaults to
# Asia/Tbilisi and should match the backend's CINEMA_TIMEZONE.
VITE_CINEMA_TIMEZONE=Asia/Tbilisi
