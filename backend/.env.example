# ---------------------------------------------------------------------------
# Movie Reservation System — backend environment template.
#
# Copy this file to backend/.env and replace the placeholder values.
# backend/.env is git-ignored; never commit real credentials.
#
# Every variable below is read by src/core/config.py, except:
#   * SEED_ADMIN_* and DEMO_* (at the end), read only by the seed scripts
#     (`python -m src.db.seed` and `python -m src.db.seed_demo`), and
#   * TEST_DATABASE_URL, read only by the integration tests
#     (backend/tests/).
# ---------------------------------------------------------------------------

# Application database URL (psycopg driver). Hosted Postgres (Neon): use the
# direct, non-pooled connection string with the postgresql+psycopg:// scheme
# and sslmode=require. backend/docker-compose.yml is a local-dev fallback only.
# Placeholder — not a real host or credential.
DATABASE_URL=postgresql+psycopg://user:password@host/database?sslmode=require

# Synchronous database URL used ONLY by the integration tests in backend/tests/.
# Same hosted-Postgres rules as DATABASE_URL, but the database name MUST end
# with "_test": a session-scoped guard refuses to run otherwise, because the
# migration test drops every table.
# Placeholder — not a real host or credential.
TEST_DATABASE_URL=postgresql+psycopg://user:password@host/database_test?sslmode=require

# Secret used to sign and verify JWTs. REQUIRED: config.py fails loudly at
# startup if this is unset or blank. Generate one with, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Placeholder — do not use as-is.
JWT_SECRET=replace_me_with_a_long_random_value

# JWT lifetime, in minutes. Optional; defaults to 60.
JWT_EXPIRY_MINUTES=60

# How long a seat hold stays active before expiring, in minutes.
# Optional; defaults to 15.
SEAT_HOLD_EXPIRY_MINUTES=15

# IANA timezone that defines a "calendar day" for browsing showtimes by date.
# Optional; defaults to Asia/Tbilisi. Must be a known IANA name.
CINEMA_TIMEZONE=Asia/Tbilisi

# Minimum minutes between two showtimes on the same screen.
# Optional; defaults to 180. Must be between 30 and 600 inclusive.
SHOWTIME_SLOT_MINUTES=180

# How long a seat hold stays active, in minutes. Optional; defaults to 10. Must be between 1 and 60 inclusive.
HOLD_MINUTES=10

# Maximum number of seats in one hold. Optional; defaults to 8. Must be between 1 and 20 inclusive.
MAX_SEATS_PER_HOLD=8

# Browser origins allowed to call the API (CORS), as a comma-separated list.
# Optional; defaults to http://localhost:5173,http://127.0.0.1:5173 (the Vite
# development server, written both ways). Each entry must be a bare origin —
# scheme + host [+ port] — with no path, query, fragment, credentials or
# trailing slash. A wildcard "*" is refused, and the application refuses to
# start if any entry is invalid. The variable replaces the default list; it is
# never extended.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Seed credentials — read ONLY by `python -m src.db.seed`, never by the
# application (src/core/config.py does not define these fields). They create
# the first admin account, so both are REQUIRED when the seed runs and the
# script exits non-zero if either is unset or blank.
# Placeholders — replace with real values in backend/.env; never commit them.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-before-use

# ---------------------------------------------------------------------------
# Showcase seed credentials — read ONLY by `python -m src.db.seed_demo`, never
# by the application (src/core/config.py does not define these fields). The
# command creates a demo account from them and refuses to run (exit code 1)
# when either is unset or blank; there is no default password anywhere in the
# code or the docs. The command also refuses a database whose name ends with
# "_test", so this file never seeds the test database.
# Placeholders — replace with real values in backend/.env; never commit them.
# DEMO_POSTER_BASE_URL is optional and defaults to http://localhost:5173: it is
# the origin the seeded poster paths (/posters/<slug>.svg) are resolved against.
# ---------------------------------------------------------------------------
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=change-me-before-use
DEMO_POSTER_BASE_URL=http://localhost:5173
