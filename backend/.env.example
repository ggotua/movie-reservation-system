# ---------------------------------------------------------------------------
# Movie Reservation System — backend environment template.
#
# Copy this file to backend/.env and replace the placeholder values.
# backend/.env is git-ignored; never commit real credentials.
#
# Every variable below is read by src/core/config.py, except:
#   * SEED_ADMIN_* (at the end), read only by the seed script
#     (`python -m src.db.seed`), and
#   * TEST_DATABASE_URL, read only by the integration tests
#     (backend/tests/).
# ---------------------------------------------------------------------------

# Application database URL (psycopg driver). Hosted Postgres (Neon): use the
# direct, non-pooled connection string with the postgresql+psycopg:// scheme
# and sslmode=require. backend/docker-compose.yml is a local-dev fallback only.
# Placeholder — not a real host or credential.
DATABASE_URL=postgresql+psycopg://user:password@host/database?sslmode=require

# Synchronous database URL used ONLY by the integration tests in backend/tests/.
# Same hosted-Postgres rules as DATABASE_URL, but the database name MUST end
# with "_test": a session-scoped guard refuses to run otherwise, because the
# migration test drops every table.
# Placeholder — not a real host or credential.
TEST_DATABASE_URL=postgresql+psycopg://user:password@host/database_test?sslmode=require

# Secret used to sign and verify JWTs. REQUIRED: config.py fails loudly at
# startup if this is unset or blank. Generate one with, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Placeholder — do not use as-is.
JWT_SECRET=replace_me_with_a_long_random_value

# JWT lifetime, in minutes. Optional; defaults to 60.
JWT_EXPIRY_MINUTES=60

# How long a seat hold stays active before expiring, in minutes.
# Optional; defaults to 15.
SEAT_HOLD_EXPIRY_MINUTES=15

# ---------------------------------------------------------------------------
# Seed credentials — read ONLY by `python -m src.db.seed`, never by the
# application (src/core/config.py does not define these fields). They create
# the first admin account, so both are REQUIRED when the seed runs and the
# script exits non-zero if either is unset or blank.
# Placeholders — replace with real values in backend/.env; never commit them.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-before-use
